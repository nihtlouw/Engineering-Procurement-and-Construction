# Salin ke .env.local (jangan pernah commit .env.local).
# Semua nilai di file ini HANYA placeholder, bukan secret.

# PostgreSQL pooled connection string (Neon / Supabase Postgres).
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# WAJIB di production: >= 32 karakter acak untuk HMAC signed URL file.
# Generate: openssl rand -hex 32
FILE_SIGNING_SECRET=replace-with-a-long-random-secret

# Opsional, hanya untuk `npm run db:seed:demo` (CLI). Tidak ada password bawaan.
SEED_DEMO_PASSWORD=replace-with-a-demo-password

# Opsional
PG_POOL_MAX=10
# Hanya untuk environment UJI yang sengaja memakai data demo di NODE_ENV=production.
ALLOW_DEMO_SEED=no
# Aktifkan test integrasi RLS: EPC_RLS_TEST=1 npm test
EPC_RLS_TEST=0
